generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Habit {
  id        Int     @id @default(autoincrement())
  name      String
  completed Boolean @default(false)
}

model Reminder {
  id        Int      @id @default(autoincrement())
  title     String
  time      String
  createdAt DateTime @default(now())
}